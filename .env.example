# Ferie — Synlab Manifattura Firenze · copia in .env e personalizza

# --- Server ---
PORT=8080
HOST=127.0.0.1
ORG_NAME=Synlab Manifattura Firenze
ORG_SHORT=Synlab
ORG_SITE=Manifattura Firenze
ORG_BRAND=SYNLAB
# URL pubblico usato nei link delle email (obbligatorio se le email devono funzionare da altri dispositivi)
# APP_BASE_URL=https://ferie.esempio.it

# --- Hosting su una VM (deploy/docker-compose.yml) ---
# Indirizzo che Caddy mette in HTTPS automatico: un dominio tuo oppure un nome
# sslip.io con l'IP della VM al posto dei punti (es. 158-101-23-45.sslip.io).
# Vedi docs/hosting.md.
# SITE_ADDRESS=ferie.esempio.it

# --- Email: opzione 1, Resend (HTTPS) ---
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
# MAIL_FROM=ferie@esempio.it
# MAIL_FROM_NAME=Synlab Manifattura Firenze

# --- Email: opzione 2, SMTP ---
# SMTP_HOST=smtp.esempio.it
# SMTP_PORT=587
# SMTP_USER=ferie@esempio.it
# SMTP_PASS=password
# SMTP_STARTTLS=1
# MAIL_FROM=ferie@esempio.it

# Reply-To facoltativo (es. la casella del coordinatore)
# MAIL_REPLY_TO=coordinatore@esempio.it

# Email aggiuntive che ricevono le richieste, separate da virgola
# COORDINATOR_EMAILS=coordinatore@esempio.it, titolare@esempio.it

# Promemoria al coordinatore dopo N ore di attesa (0 = disattivato)
# REMINDER_HOURS=24

# --- Notifiche push ---
# Contatto incluso nelle notifiche (default: MAIL_FROM). Le chiavi VAPID
# vengono generate in data/vapid.json al primo uso.
# VAPID_SUBJECT=mailto:ferie@esempio.it
